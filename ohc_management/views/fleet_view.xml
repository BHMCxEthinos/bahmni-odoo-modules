<record id="ohc_fleet_odometer_form" model="ir.ui.view">
    <field name="name">ohc.fleet.odometer.form</field>
    <field name="model">fleet.vehicle.odometer</field>
    <field name="inherit_id" ref="fleet.fleet_vehicle_odometer_view_form"/>
    <field name="arch" type="xml">
        
        <!-- Vehicle dropdown domain filter -->
        <xpath expr="//field[@name='vehicle_id']" position="attributes">
             <attribute name="domain">[('ohc_id', '=', context.get('default_ohc_id', False))]</attribute>
        </xpath>

        <!-- Move the custom groups outside of the top field group -->
        <xpath expr="//sheet/group[1]" position="after">
            <group>
                <group string="Movement Details">
                    <field name="ohc_ambulance_movement"/>
                    <field name="ohc_movement_date"/>
                    <field name="ohc_movement_time"/>
                    <field name="ohc_patient_name"
                           attrs="{'invisible': [('ohc_ambulance_movement', '=', 'without_patient')],
                                  'readonly': [('ohc_ambulance_movement', '=', 'without_patient')]}"/>
                    <field name="ohc_purpose"/>
                    <field name="ohc_destination"/>
                    <field name="ohc_notes"/>
                    <field name="ohc_driver_name" string="Driver Name"/>
                </group>
                <group string="Trip Details">
                    <field name="ohc_departure_time"/>
                    <field name="ohc_departure_start_km"/>
                    <field name="ohc_arrival_time"/>
                    <field name="ohc_arrival_end_km"/>
                    <field name="ohc_distance_travelled" readonly="1"/>
                </group>
            </group>
        </xpath>
        
    </field>
</record>

</odoo>