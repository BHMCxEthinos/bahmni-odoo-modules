    <record id="survey_survey_form_inherit_ohc" model="ir.ui.view">

    <field name="name">survey.survey.form.inherit.ohc</field>

    <field name="model">survey.survey</field>

    <field name="inherit_id" ref="survey.survey_survey_view_form"/>

    <field name="arch" type="xml">

        <!-- Change existing Responsible field from Many2One widget to Many2Many -->
        
 <xpath expr="//field[@name='active']/preceding-sibling::field[@name='user_id'][1]"
           position="attributes">
        <attribute name="invisible">1</attribute>
    </xpath>

    <!-- Add OHC and Type -->
    <xpath expr="//field[@name='user_id']" position="after">
        <field name="ohc_ids" widget="many2many_tags"/>
        <field name="survey_type"/>
    </xpath>

    <!-- Put new Responsible before OHC -->
    <xpath expr="//field[@name='ohc_ids']" position="before">
        <field name="user_ids"
               widget="many2many_tags"
               domain="[('share', '=', False)]"/>
    </xpath>


    </field>

</record>

</odoo>