<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="view_employee_form_inherit_ohc"
            model="ir.ui.view">

        <field name="name">hr.employee.form.inherit.ohc</field>

        <field name="model">hr.employee</field>

        <field name="inherit_id"
               ref="hr.view_employee_form"/>

        <field name="arch"
               type="xml">

            <xpath expr="//field[@name='work_email']"
                   position="after">

                <!-- <field name="ohc_id" widget="many2many_tags"/> to show only ohc name-->
                <field name="ohc_id"/>


            </xpath>

        </field>

    </record>

</odoo>