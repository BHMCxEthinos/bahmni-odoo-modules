<odoo>
  <record id="view_partner_ohc_form" model="ir.ui.view">
    <field name="name">res.partner.ohc.form</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">

      <!-- Smart Button -->
      <xpath expr="//div[@name='button_box']" position="inside">
        <button name="action_view_compliance"
          type="object"
          class="oe_stat_button"
          icon="fa-check-circle"
          attrs="{'invisible': [('is_ohc', '=', False)]}">
          <div class="o_stat_info">
            <field name="compliance_count" class="o_stat_value"/>
            <span class="o_stat_text">Compliances</span>
          </div>
        </button>
      </xpath>

      <!-- Is OHC field -->
      <xpath expr="//field[@name='name']" position="after">
        <field name="is_ohc" string="Is OHC"/>
      </xpath>

    </field>
  </record>
</odoo>