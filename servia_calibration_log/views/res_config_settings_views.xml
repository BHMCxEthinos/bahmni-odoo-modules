<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_servia_calibration" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.servia.calibration</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Calibration" string="Calibration"
                     data-key="servia_calibration_log">
                    <h2>Calibration Reminders</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="calibration_reminder_days"/>
                                <div class="text-muted">
                                    Days before Next Due to send a reminder
                                </div>
                                <div class="content-group">
                                    <field name="calibration_reminder_days" class="o_light_label"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="calibration_reminder_fallback_email"/>
                                <div class="text-muted">
                                    Used only if equipment has no Technician/Owner set
                                </div>
                                <div class="content-group">
                                    <field name="calibration_reminder_fallback_email" class="o_light_label"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
