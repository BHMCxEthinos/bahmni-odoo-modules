<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_ohc_stock_replenishment_alert" model="ir.cron">
            <field name="name">Stock Replenishment Email Alert</field>
            <field name="model_id" ref="stock.model_stock_warehouse_orderpoint"/>
            <field name="state">code</field>
            <field name="code">model.env['ohc.stock.replenishment.cron'].run_stock_replenishment_alert()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>

        <record id="ir_cron_ohc_expiry_alert" model="ir.cron">
            <field name="name">Product Expiry Email Alert</field>
            <field name="model_id" ref="stock.model_stock_lot"/>
            <field name="state">code</field>
            <field name="code">model.env['ohc.expiry.alert.cron'].run_expiry_alert()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>