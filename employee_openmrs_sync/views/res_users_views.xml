<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_users_form_inherit_clinical" model="ir.ui.view">
    <field name="name">res.users.form.clinical.user</field>
    <field name="model">res.users</field>
    <field name="inherit_id" ref="base.view_users_form"/>
    <field name="arch" type="xml">

        <xpath expr="//field[@name='share']" position="after">
    <div class="o_row">
        <label for="clinical_user"/>
        <field name="clinical_user" readonly="1"/>
    </div>
</xpath>
    </field>
</record>
</odoo>