<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_b2b_crm_product_domain" model="ir.ui.view">
        <field name="name">sale.order.form.b2b.crm.product.domain</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/tree/field[@name='product_id']" position="attributes">
                <attribute name="domain">(context.get('is_b2b_crm') and context.get('crm_b2b_categ_id') and [('sale_ok', '=', True), ('categ_id', 'child_of', context.get('crm_b2b_categ_id'))]) or [('sale_ok', '=', True)]</attribute>
            </xpath>
        </field>
    </record>
</odoo>