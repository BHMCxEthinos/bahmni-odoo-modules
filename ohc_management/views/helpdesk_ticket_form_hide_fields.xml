        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="support_helpdesk_ticket.view_helpdesk_ticket_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='team_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//button[@name='action_open_linked_records']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
